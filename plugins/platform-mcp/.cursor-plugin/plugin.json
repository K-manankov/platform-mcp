{
  "name": "platform-mcp",
  "displayName": "Platform MCP (Argo CD + Vault + Keycloak)",
  "version": "0.4.7",
  "description": "Argo CD, Vault и Keycloak кластера sonar-prod с SSO-входом. Команды выполняются от имени вошедшего пользователя, значения секретов в контекст модели не попадают.",
  "author": {
    "name": "infra/k8s"
  },
  "homepage": "https://git.sonar-corp.ru/infra/k8s/platform-mcp",
  "repository": "https://git.sonar-corp.ru/infra/k8s/platform-mcp.git",
  "keywords": [
    "argocd",
    "vault",
    "keycloak",
    "kubernetes",
    "sso",
    "infrastructure"
  ],
  "mcpServers": "./mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "ARGOCD_BASE_URL": {
        "type": "string",
        "title": "Argo CD URL",
        "description": "Базовый URL Argo CD",
        "default": "https://argocd.infra.sonar-corp.ru"
      },
      "VAULT_ADDR": {
        "type": "string",
        "title": "Vault URL",
        "description": "Базовый URL Vault",
        "default": "https://vault.infra.sonar-corp.ru"
      },
      "KEYCLOAK_BASE_URL": {
        "type": "string",
        "title": "Keycloak URL",
        "description": "Базовый URL Keycloak (без /realms/...)",
        "default": "https://auth.infra.sonar-corp.ru"
      },
      "PLATFORM_MCP_INSECURE": {
        "type": "string",
        "title": "Skip TLS verify",
        "description": "true, пока у ingress нет нормальных сертификатов",
        "default": "true",
        "enum": [
          "true",
          "false"
        ]
      },
      "VAULT_OIDC_MOUNT": {
        "type": "string",
        "title": "Vault OIDC mount",
        "description": "oidc — обычный вход; oidc-admin — полные права для Owner'ов группы infra/k8s",
        "default": "oidc",
        "enum": [
          "oidc",
          "oidc-admin"
        ]
      }
    }
  }
}
